{
  "name": "app",
  "version": "0.0.3",
  "engines": {
    "node": "24.21.0",
    "npm": "11.21.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --hmr --proxy-config proxy.conf.json",
    "start": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --proxy-config proxy.conf.json",
    "build": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --configuration=production --base-href=/ && npm run cache-bust",
    "build:dev": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --base-href=/ && npm run cache-bust",
    "cache-bust": "node scripts/cache-busting.js",
    "test:cache-busting": "node scripts/test-cache-busting.js",
    "test": "ng test",
    "test:watch": "ng test --watch --verbose --silent=false",
    "test:report": "ng test --coverage",
    "test:scripts": "node --test scripts/generate-icon-font.test.mjs",
    "lint": "ng lint",
    "lint:unused": "npx ngx-unused . -p tsconfig.json",
    "generate:types:zac-openapi": "npx openapi-typescript ./../../../build/generated/openapi/META-INF/openapi/openapi.json -o ./src/generated/types/zac-openapi-types.d.ts",
    "generate:icon-font": "node scripts/generate-icon-font.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/elements": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/material": "20.2.14",
    "@angular/material-moment-adapter": "20.2.14",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/router": "20.3.33",
    "@formio/angular": "10.0.1",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@tanstack/angular-query-experimental": "5.104.1",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/query-persist-client-core": "5.104.1",
    "bootstrap": "5.3.8",
    "moment": "2.31.0",
    "ngx-editor": "18.0.0",
    "ol": "10.11.0",
    "openapi-fetch": "0.17.0",
    "proj4": "2.22.0",
    "rxjs": "7.8.2",
    "ts-pattern": "5.9.0",
    "zone.js": "0.15.1"
  },
  "overrides": {
    "@hono/node-server": "2.1.3",
    "postcss": "8.5.29",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.0.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "20.0.0",
    "@angular-devkit/build-angular": "20.3.39",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/build": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@angular/language-service": "20.3.33",
    "@formio/core": "2.9.0",
    "@testing-library/angular": "18.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-testing-library": "7.16.2",
    "expect-type": "1.4.0",
    "harfbuzzjs": "1.6.2",
    "jest": "29.7.0",
    "jest-extended": "7.0.0",
    "jest-junit": "17.0.0",
    "jest-preset-angular": "14.6.2",
    "less": "4.9.1",
    "openapi-typescript": "7.13.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "woff2-encoder": "2.0.0"
  }
