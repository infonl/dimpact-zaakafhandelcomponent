{
  "name": "app",
  "version": "0.0.3",
  "engines": {
    "node": "24.22.2",
    "npm": "11.21.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --hmr --proxy-config proxy.conf.json",
    "start": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --proxy-config proxy.conf.json",
    "build": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --configuration=production --base-href=/ && npm run cache-bust",
    "build:dev": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --base-href=/ && npm run cache-bust",
    "cache-bust": "node scripts/cache-busting.js",
    "test:cache-busting": "node scripts/test-cache-busting.js",
    "test": "ng test",
    "test:watch": "ng test --watch --verbose --silent=false",
    "test:report": "ng test --coverage",
    "test:scripts": "node --test scripts/generate-icon-font.test.mjs",
    "lint": "ng lint && npm run lint:styles && npm run lint:spec-templates",
    "lint:styles": "stylelint \"src/**/*.less\"",
    "lint:spec-templates": "npm run generate:types:zac-openapi && ngc -p tsconfig.spec.json --noEmit",
    "lint:unused": "npx ngx-unused . -p tsconfig.json",
    "generate:types:zac-openapi": "npx openapi-typescript ./../../../build/generated/openapi/META-INF/openapi/openapi.json -o ./src/generated/types/zac-openapi-types.d.ts",
    "generate:icon-font": "node scripts/generate-icon-font.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/elements": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/material-moment-adapter": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@formio/angular": "11.0.6",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@tanstack/angular-query-experimental": "5.104.5",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/query-persist-client-core": "5.104.5",
    "bootstrap": "5.3.8",
    "moment": "2.31.0",
    "ngx-bootstrap": "21.2.2",
    "ngx-editor": "18.0.0",
    "ol": "10.11.0",
    "openapi-fetch": "0.17.0",
    "proj4": "2.22.0",
    "rxjs": "7.8.2",
    "ts-pattern": "5.9.2",
    "zone.js": "0.15.1"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "postcss": "8.5.31",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.1.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "21.0.4",
    "@angular-devkit/build-angular": "21.2.28",
    "@angular/build": "21.2.28",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@eslint/js": "9.39.5",
    "@formio/core": "2.9.0",
    "@testing-library/angular": "18.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/dom-navigation": "1.0.7",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "expect-type": "1.4.0",
    "harfbuzzjs": "1.6.4",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "7.0.0",
    "jest-junit": "17.0.0",
    "jest-preset-angular": "16.2.0",
    "less": "4.9.1",
    "openapi-typescript": "7.13.0",
    "postcss-less": "6.0.0",
    "stylelint": "17.16.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "woff2-encoder": "2.0.0"
  }
}
