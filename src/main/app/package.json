{
  "name": "app",
  "version": "0.0.3",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --hmr --proxy-config proxy.conf.json",
    "start": "npm run generate:types:zac-openapi && npm run generate:icon-font -- --all-icons && ng serve --proxy-config proxy.conf.json",
    "build": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --configuration=production --base-href=/ && npm run cache-bust",
    "build:dev": "npm run generate:types:zac-openapi && npm run generate:icon-font && ng build --base-href=/ && npm run cache-bust",
    "cache-bust": "node scripts/cache-busting.js",
    "test:cache-busting": "node scripts/test-cache-busting.js",
    "test": "ng test",
    "test:watch": "ng test --watch --verbose --silent=false",
    "test:report": "ng test --coverage",
    "test:scripts": "node --test scripts/generate-icon-font.test.mjs",
    "lint": "ng lint && npm run lint:styles && npm run lint:spec-templates",
    "lint:styles": "stylelint \"src/**/*.less\"",
    "lint:spec-templates": "npm run generate:types:zac-openapi && ngc -p tsconfig.spec.json --noEmit",
    "lint:unused": "npx ngx-unused . -p tsconfig.json",
    "generate:types:zac-openapi": "npx openapi-typescript ./../../../build/generated/openapi/META-INF/openapi/openapi.json -o ./src/generated/types/zac-openapi-types.d.ts",
    "generate:icon-font": "node scripts/generate-icon-font.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/elements": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/material": "22.3.0",
    "@angular/material-moment-adapter": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "@formio/angular": "11.0.6",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "@tanstack/angular-query-experimental": "5.107.2",
    "@tanstack/query-async-storage-persister": "5.107.2",
    "@tanstack/query-persist-client-core": "5.107.2",
    "bootstrap": "5.3.9",
    "moment": "2.31.0",
    "ngx-bootstrap": "22.0.0",
    "ngx-editor": "19.1.1",
    "ol": "10.11.0",
    "openapi-fetch": "0.17.0",
    "proj4": "2.23.0",
    "rxjs": "7.8.2",
    "ts-pattern": "5.9.2",
    "zone.js": "0.15.1"
  },
  "overrides": {
    "@angular-devkit/core": {
      "chokidar": "6.0.0"
    },
    "@formio/angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/elements": "$@angular/elements",
      "ngx-bootstrap": "$ngx-bootstrap"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "postcss": "8.5.33",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.1.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "22.0.1",
    "@angular-devkit/build-angular": "22.3.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@eslint/js": "10.0.1",
    "@formio/core": "2.9.2",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.4",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-testing-library": "7.16.3",
    "expect-type": "1.4.0",
    "harfbuzzjs": "1.6.4",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "7.0.0",
    "jest-junit": "17.0.0",
    "jest-preset-angular": "17.0.3",
    "less": "4.9.1",
    "openapi-typescript": "7.13.0",
    "postcss-less": "7.1.1",
    "stylelint": "18.1.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "woff2-encoder": "2.0.0"
  }
}
