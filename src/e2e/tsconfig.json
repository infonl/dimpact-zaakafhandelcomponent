{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2019"],
    "module": "commonjs",
    "noImplicitAny": true,
    "strict": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSources": true,
    "target": "es2018",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"],
    "paths": {
      "@sinonjs/fake-timers": ["./node_modules/@types/sinonjs__fake-timers"]
    }
  }
}
