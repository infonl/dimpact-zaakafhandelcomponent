# The end-to-end tests need no .env file for the local kind stack.
# Copy this file to .env only to change one of these settings.

# The target of the tests: a profile in config/targets. The default is "kind".
#E2E_TARGET=kind

# For the target "kind": the name of the kind cluster. The default is "zac".
#KIND_CLUSTER_NAME=zac

# For the target "kind": the URL of ZAC, when ZAC does not run in the kind cluster, for example in your IDE.
#ZAC_URL=http://localhost:8080
