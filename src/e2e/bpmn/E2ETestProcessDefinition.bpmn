        <flowable:static-form-key><![CDATA[signSelectedDocumentsForm]]></flowable:static-form-key>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="ServiceTask_370" name="Sign documents" flowable:class="net.atos.zac.flowable.delegate.SignDocumentDelegate">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <startEvent id="start" name="Start" flowable:initiator="initiator" flowable:formFieldValidation="false">
