{
  "name": "app",
  "version": "0.0.1",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "lint": "eslint .",
    "typecheck": "npm run generate:types:zac-openapi && tsc",
    "generate:types:zac-openapi": "openapi-typescript ../../build/generated/openapi/META-INF/openapi/openapi.json -o ./generated/zac-openapi-types.d.ts"
  },
  "private": true,
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "playwright-bdd": "9.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
