{
  "name": "app",
  "version": "0.0.1",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.2"
  },
  "scripts": {
    "e2e:run": "./node_modules/.bin/cucumber-js -p default",
    "e2e:start": "npm ci --ignore-scripts && npx playwright install --with-deps && npm run e2e:run",
    "e2e:generate:report": "node generate-report.mjs",
    "e2e:extract:metrics": "node extract-metrics.mjs",
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.playwright.json"
  },
  "private": true,
  "dependencies": {
    "@cucumber/cucumber": "13.3.0",
    "pdf-parse": "2.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "multiple-cucumber-html-reporter": "4.6.0",
    "playwright-bdd": "9.2.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "cucumber.features": ["features/**/*.feature"]
}
