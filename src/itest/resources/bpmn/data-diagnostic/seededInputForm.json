    {
      "type": "content",
      "key": "waarschuwing",
      "input": false,
      "tableView": false,
      "html": "<p><strong>Pick keys that are not process variable names.</strong> Completing a task writes every submitted key back as a process variable, so a seeded field keyed <code>zaakGroep</code> would overwrite the process variable of that name. The keys above are prefixed <code>IN_</code> for exactly that reason.</p>"
    },
    {
      "key": "save",
      "label": "Save",
      "type": "button",
      "theme": "secondary",
      "input": true,
      "action": "saveState",
      "state": "draft",
      "tableView": false
    },
    {
      "type": "button",
      "label": "Complete",
      "key": "submit",
