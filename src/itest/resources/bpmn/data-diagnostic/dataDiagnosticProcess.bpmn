<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  typeLanguage="http://www.w3.org/2001/XMLSchema"
  expressionLanguage="http://www.w3.org/1999/XPath"
  targetNamespace="http://flowable.org/data">

  <process id="dataDiagnosticProcess" name="Data Diagnostic Process" isExecutable="true"
           flowable:candidateStarterGroups="flowableUser">
    <documentation>Renders every property a task form can address: one task reading the zaak, one
      reading the taak. Both open when the zaak is created and can be completed in any order. Each
      form ends with deliberate mistakes, to show what an unresolvable property or an unknown format
      function looks like. Once all three are completed the zaak is closed with resultaattype
      'Verleend', so the zaaktype linked to this process must have a resultaattype by that
      name.</documentation>

    <startEvent id="start" name="Start" flowable:initiator="initiator"/>

    <parallelGateway id="fork" name="All forms open at once"/>

    <userTask id="zaakDataTask" name="Zaak data"
              flowable:assignee="${var:get(zaakBehandelaar)}"
              flowable:candidateGroups="${zaakGroep}"
              flowable:formKey="zaakDataForm"
              flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:static-form-key><![CDATA[zaakDataForm]]></flowable:static-form-key>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
      </extensionElements>
    </userTask>

    <userTask id="taakDataTask" name="Taak data"
              flowable:assignee="${var:get(zaakBehandelaar)}"
              flowable:candidateGroups="${zaakGroep}"
              flowable:formKey="taakDataForm"
              flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:static-form-key><![CDATA[taakDataForm]]></flowable:static-form-key>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
      </extensionElements>
    </userTask>

    <userTask id="processDataTask" name="Process data"
              flowable:assignee="${var:get(zaakBehandelaar)}"
              flowable:candidateGroups="${zaakGroep}"
              flowable:formKey="processDataForm"
              flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:static-form-key><![CDATA[processDataForm]]></flowable:static-form-key>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
      </extensionElements>
    </userTask>

    <userTask id="seededInputTask" name="Seeded inputs"
              flowable:assignee="${var:get(zaakBehandelaar)}"
              flowable:candidateGroups="${zaakGroep}"
              flowable:formKey="seededInputForm"
              flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:static-form-key><![CDATA[seededInputForm]]></flowable:static-form-key>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
      </extensionElements>
    </userTask>

    <parallelGateway id="join" name="All completed"/>

    <serviceTask id="closeZaak" name="Close zaak"
                 flowable:class="net.atos.zac.flowable.delegate.UpdateZaakJavaDelegate">
      <extensionElements>
        <flowable:field name="statustypeOmschrijving">
          <flowable:string><![CDATA[Afgerond]]></flowable:string>
        </flowable:field>
        <flowable:field name="resultaattypeOmschrijving">
          <flowable:string><![CDATA[Verleend]]></flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>

    <endEvent id="end" name="End"/>

    <sequenceFlow id="flowStartFork" sourceRef="start" targetRef="fork"/>
    <sequenceFlow id="flowForkZaak" sourceRef="fork" targetRef="zaakDataTask"/>
    <sequenceFlow id="flowForkTaak" sourceRef="fork" targetRef="taakDataTask"/>
    <sequenceFlow id="flowForkSeeded" sourceRef="fork" targetRef="seededInputTask"/>
    <sequenceFlow id="flowSeededJoin" sourceRef="seededInputTask" targetRef="join"/>
    <sequenceFlow id="flowForkProcess" sourceRef="fork" targetRef="processDataTask"/>
    <sequenceFlow id="flowProcessJoin" sourceRef="processDataTask" targetRef="join"/>
    <sequenceFlow id="flowZaakJoin" sourceRef="zaakDataTask" targetRef="join"/>
    <sequenceFlow id="flowTaakJoin" sourceRef="taakDataTask" targetRef="join"/>
    <sequenceFlow id="flowJoinClose" sourceRef="join" targetRef="closeZaak"/>
    <sequenceFlow id="flowCloseEnd" sourceRef="closeZaak" targetRef="end"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_dataDiagnosticProcess">
    <bpmndi:BPMNPlane bpmnElement="dataDiagnosticProcess" id="BPMNPlane_dataDiagnosticProcess">
      <bpmndi:BPMNShape bpmnElement="start" id="BPMNShape_start">
        <omgdc:Bounds height="30.0" width="30.0" x="100.0" y="185.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="fork" id="BPMNShape_fork">
        <omgdc:Bounds height="40.0" width="40.0" x="180.0" y="180.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="zaakDataTask" id="BPMNShape_zaakDataTask">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="taakDataTask" id="BPMNShape_taakDataTask">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="230.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="processDataTask" id="BPMNShape_processDataTask">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="360.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="seededInputTask" id="BPMNShape_seededInputTask">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="490.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="join" id="BPMNShape_join">
        <omgdc:Bounds height="40.0" width="40.0" x="440.0" y="180.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="closeZaak" id="BPMNShape_closeZaak">
        <omgdc:Bounds height="80.0" width="100.0" x="530.0" y="160.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="end" id="BPMNShape_end">
        <omgdc:Bounds height="28.0" width="28.0" x="690.0" y="186.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flowStartFork" id="BPMNEdge_flowStartFork">
        <omgdi:waypoint x="130.0" y="200.0"/>
        <omgdi:waypoint x="180.0" y="200.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowForkZaak" id="BPMNEdge_flowForkZaak">
        <omgdi:waypoint x="200.0" y="180.0"/>
        <omgdi:waypoint x="200.0" y="140.0"/>
        <omgdi:waypoint x="280.0" y="140.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowForkTaak" id="BPMNEdge_flowForkTaak">
        <omgdi:waypoint x="200.0" y="220.0"/>
        <omgdi:waypoint x="200.0" y="270.0"/>
        <omgdi:waypoint x="280.0" y="270.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowZaakJoin" id="BPMNEdge_flowZaakJoin">
        <omgdi:waypoint x="380.0" y="140.0"/>
        <omgdi:waypoint x="460.0" y="140.0"/>
        <omgdi:waypoint x="460.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowTaakJoin" id="BPMNEdge_flowTaakJoin">
        <omgdi:waypoint x="380.0" y="270.0"/>
        <omgdi:waypoint x="460.0" y="270.0"/>
        <omgdi:waypoint x="460.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowForkProcess" id="BPMNEdge_flowForkProcess">
        <omgdi:waypoint x="200.0" y="220.0"/>
        <omgdi:waypoint x="200.0" y="400.0"/>
        <omgdi:waypoint x="280.0" y="400.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowProcessJoin" id="BPMNEdge_flowProcessJoin">
        <omgdi:waypoint x="380.0" y="400.0"/>
        <omgdi:waypoint x="460.0" y="400.0"/>
        <omgdi:waypoint x="460.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowForkSeeded" id="BPMNEdge_flowForkSeeded">
        <omgdi:waypoint x="200.0" y="220.0"/>
        <omgdi:waypoint x="200.0" y="530.0"/>
        <omgdi:waypoint x="280.0" y="530.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowSeededJoin" id="BPMNEdge_flowSeededJoin">
        <omgdi:waypoint x="380.0" y="530.0"/>
        <omgdi:waypoint x="460.0" y="530.0"/>
        <omgdi:waypoint x="460.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowJoinClose" id="BPMNEdge_flowJoinClose">
        <omgdi:waypoint x="480.0" y="200.0"/>
        <omgdi:waypoint x="530.0" y="200.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowCloseEnd" id="BPMNEdge_flowCloseEnd">
        <omgdi:waypoint x="630.0" y="200.0"/>
        <omgdi:waypoint x="690.0" y="200.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
