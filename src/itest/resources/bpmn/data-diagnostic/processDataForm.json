          "key": "PD_fout_wildcard_niet_laatst",
          "input": false,
          "tableView": false,
          "html": "<span class=\"fw-medium\">a key of an object reached through a wildcard: </span><em>no template equivalent</em>"
        },
        {
          "label": "",
          "type": "content",
          "key": "PD_fout_wildcard_na_lijst",
          "input": false,
          "tableView": false,
          "html": "<span class=\"fw-medium\">ZAC_zaak_gegevens  ·  ZAC_VELD: kenmerken[].*: </span><em>kenmerken[].* &mdash; no template equivalent: {{ }} cannot list keys it does not know</em>"
        },
        {
          "label": "",
          "type": "content",
          "key": "PD_fout_object_zonder_wildcard",
          "input": false,
          "tableView": false,
          "html": "<span class=\"fw-medium\">ZAC_zaak_gegevens  ·  ZAC_VELD: zaaktype: </span>{{ zaak.zaaktype }}"
        }
      ]
    },
    {
      "key": "save",
