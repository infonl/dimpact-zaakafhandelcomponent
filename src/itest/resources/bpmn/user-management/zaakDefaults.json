{
  "display": "form",
  "name": "zaakDefaults",
  "title": "Zaak defaults",
  "type": "form",
  "components": [
    {
      "title": "Zaak defaults",
      "label": "Zaak defaults",
      "type": "panel",
      "key": "form",
      "input": false,
      "components": [
        {
          "label": "Group",
          "labelPosition": "left-left",
          "key": "zaakGroep",
          "type": "textfield",
          "input": false,
          "disabled": true
        },
        {
          "label": "User",
          "labelPosition": "left-left",
          "key": "zaakBehandelaar",
          "type": "textfield",
          "defaultValue": "-- not set --",
          "input": false,
          "disabled": true
        },
        {
          "label": "",
          "type": "content",
          "key": "ZO_GroepVergelijking",
          "input": false,
          "html": "<p>Zaak {{ zaak.identificatie }}: groep {{ zaak.groep.naam }}, behandelaar {{ zaak.behandelaar.naam }}. Taak <em>{{ taak.naam }}</em>: groep {{ taak.groep.naam }}.</p>"
        },
        {
          "label": "Group (prefilled from the zaak)",
          "labelPosition": "left-left",
          "key": "ZO_Groep",
          "type": "textfield",
          "input": true,
          "disabled": true,
          "customDefaultValue": "value = zaak.groep.naam"
        }
      ]
    },
    {
      "type": "button",
      "label": "Next",
      "key": "submit",
      "disableOnInvalid": true,
      "input": true,
      "tableView": false
    }
  ]
}
