# Docker Compose environment of the integration test stack.
#
# Both the integration tests and the CI workflow pass this file to Docker Compose with '--env-file', so
# that the stack is configured identically whoever starts it. Passing it also stops Docker Compose from
# loading a local '.env' file, which could otherwise override variables the integration tests rely on.
#
# The URIs and keys below have to match the constants in 'ItestConfiguration' that the specs use to reach
# the same mocks.

APP_ENV=itest
AUTH_SSL_REQUIRED=none

BAG_API_CLIENT_MP_REST_URL=http://bag-wiremock.local:8080/lvbag/individuelebevragingen/v2/
KVK_API_CLIENT_MP_REST_URL=http://kvk-wiremock:8080
OFFICE_CONVERTER_CLIENT_MP_REST_URL=http://office-converter:3000
PABC_API_CLIENT_MP_REST_URL=http://pabc-api:8000
PABC_API_KEY=zac-test-api-key

BRP_PROTOCOLLERING_ENABLED=true
BRP_DOELBINDING_PER_ZAAKTYPE=true

SMARTDOCUMENTS_ENABLED=true
SMARTDOCUMENTS_CLIENT_MP_REST_URL=http://smartdocuments-wiremock:8080

SMTP_SERVER=greenmail
SMTP_PORT=25

SIGNALERINGEN_DELETE_OLDER_THAN_DAYS=0

ZAC_INTERNAL_ENDPOINTS_API_KEY=zacItestInternalEndpointsApiKey

# The image is overridden by the 'ZAC_DOCKER_IMAGE' environment variable, which takes precedence over this file.
ZAC_DOCKER_IMAGE=ghcr.io/infonl/zaakafhandelcomponent:dev

# Records the integration test code coverage with the JaCoCo agent and makes the WildFly management port
# accessible from outside the container.
ZAC_DOCKER_ENTRYPOINT=java -javaagent:/jacoco-agent/org.jacoco.agent-runtime.jar=destfile=/jacoco-report/jacoco-it.exec -Djboss.bind.address.management=0.0.0.0 -Xms1024m -Xmx1024m -jar zaakafhandelcomponent.jar
